# Copy this file to .env.local and fill in real values. .env.local is gitignored;
# this file (.env.example) is the only one meant to be committed, with placeholders only.

# ---- Firebase client config (used ONLY by the narrow /supercore/login Google
# ---- sign-in component — these values are meant to be public per Firebase's own
# ---- security model; do not treat them as secret, but also don't use them for
# ---- anything beyond that one login screen) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---- Firebase Admin SDK (server-only, real secret — a service account, NOT the
# ---- web config above). Generate at: Firebase Console -> Project Settings ->
# ---- Service Accounts -> Generate new private key. That downloads a JSON file;
# ---- copy its three fields here. FIREBASE_PRIVATE_KEY must keep its \n escapes
# ---- literal (paste the JSON value's private_key string as-is, in quotes). ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Admin gate (the shared password screen in front of /supercore/login) ----
ADMIN_GATE_PASSWORD=
# Random signing secret for the gate's session cookie — NOT the password itself.
# Generate your own with: openssl rand -hex 32
ADMIN_GATE_SECRET=

# ---- Google Sheets sync (Apps Script Web App) ----
APPS_SCRIPT_URL=

# ---- Registration defaults ----
UPI_VPA=

# ---- Email (optional — unset means registration/status emails just log to the
# ---- server console instead of sending; wire a real provider later via
# ---- `vercel integration discover --category messaging`) ----
EMAIL_PROVIDER=

# ---- Analytics ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=
