      target_content: "import { BrowserRouter as Router, Routes, Route, Outlet } from \'react-router-dom\';\nimport { Navbar } from \'./components/Navbar\';\nimport { Footer } from \'./components/Footer\';\nimport { LandingPage } from \'./pages/LandingPage\';\nimport { SchedulePage } from \'./pages/SchedulePage\';\nimport { EventDetailPage } from \'./pages/EventDetailPage\';\nimport { RegistrationsPage } from \'./pages/RegistrationsPage\';\nimport { AdminEventsPage } from \'./pages/AdminEventsPage\';\nimport { AdminUsersPage } from \'./pages/AdminUsersPage\';\nimport { AdminWinnersPage } from \'./pages/AdminWinnersPage\';\nimport { AuditLogPage } from \'./pages/AuditLogPage\';\n\nfunction Layout() {\n  return (\n    <div className=\"min-h-screen flex flex-col bg-bg-base text-text-primary border-[12px] border-border-subtle overflow-x-hidden\">\n      <Navbar />\n      <main className=\"flex-grow flex flex-col relative w-full bg-bg-elevated\">\n        <Outlet />\n      </main>\n      <Footer />\n    </div>\n  );\n}\n\nexport default function App() {\n  return (\n    <Router>\n      <Routes>\n        <Route path=\"/\" element={<Layout />}>\n          <Route index element={<LandingPage />} />\n          <Route path=\"schedule\" element={<SchedulePage />} />\n          <Route path=\"events/:id\" element={<EventDetailPage />} />\n          <Route path=\"registrations\" element={<RegistrationsPage />} />\n          <Route path=\"admin/events\" element={<AdminEventsPage />} />\n          <Route path=\"admin/users\" element={<AdminUsersPage />} />\n          <Route path=\"admin/winners\" element={<AdminWinnersPage />} />\n          <Route path=\"admin/audit-log\" element={<AuditLogPage />} />\n        </Route>\n      </Routes>\n    </Router>\n  );\n}"
      replacement_content: "export default function App() {\n  return (\n    <div className=\"w-full h-screen bg-black text-white flex flex-col font-sans overflow-hidden select-none border-[12px] border-neutral-900\">\n      <header className=\"h-40 border-b border-neutral-800 flex flex-col justify-end p-8\">\n        <div className=\"flex justify-between items-baseline\">\n          <h1 className=\"text-[140px] font-black tracking-tighter leading-[0.75] uppercase\">Strict_01</h1>\n          <div className=\"text-right flex flex-col gap-1\">\n            <div className=\"flex items-center justify-end gap-2 text-green-500\">\n              <span className=\"w-2 h-2 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.6)]\"></span>\n              <span className=\"font-mono text-xs font-bold tracking-widest uppercase\">Execution Active</span>\n            </div>\n            <div className=\"font-mono text-[10px] text-neutral-500\">CRC: 0xFFA24B00 // 1024x768_VIEWPORT</div>\n          </div>\n        </div>\n      </header>\n      <div className=\"flex-1 flex overflow-hidden\">\n        <aside className=\"w-72 border-r border-neutral-800 flex flex-col\">\n          <div className=\"p-6 border-b border-neutral-800\">\n            <span className=\"text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-500\">System Hierarchy</span>\n          </div>\n          <div className=\"flex-1 p-6 font-mono text-xs space-y-6 text-neutral-400\">\n            <div className=\"space-y-1\">\n              <div className=\"text-neutral-600\">/ root / config /</div>\n              <div className=\"text-white border-l border-white pl-3 py-1\">memory_ccmf.json</div>\n              <div className=\"pl-4 opacity-30\">schema_v2.proto</div>\n              <div className=\"pl-4 opacity-30\">logic_v1.bin</div>\n            </div>\n            <div className=\"pt-12 space-y-4\">\n              <div className=\"p-3 bg-neutral-900 border-l-4 border-white\">\n                <div className=\"text-[9px] text-neutral-500 mb-1 uppercase\">Directive Alpha</div>\n                <div className=\"text-white font-bold\">VERBATIM_ONLY</div>\n              </div>\n              <div className=\"p-3 border-l-4 border-neutral-800 opacity-40\">\n                <div className=\"text-[9px] text-neutral-500 mb-1 uppercase\">Directive Beta</div>\n                <div className=\"text-neutral-400\">ZERO_INFERENCE</div>\n              </div>\n            </div>\n          </div>\n        </aside>\n        <main className=\"flex-1 flex flex-col bg-neutral-950 p-8 relative\">\n          <div className=\"absolute -bottom-20 -right-10 text-[320px] font-black text-white/[0.03] pointer-events-none\">EXE</div>\n          <div className=\"flex-1 flex flex-col gap-8 relative z-10\">\n            <div className=\"flex items-center gap-4 text-neutral-500 text-[10px] font-bold uppercase tracking-widest\">\n              <span className=\"w-12 h-[1px] bg-neutral-800\"></span> Workspace Terminal\n            </div>\n            <div className=\"grid grid-cols-2 gap-8 flex-1\">\n              <div className=\"border border-neutral-800 bg-black p-6 font-mono text-[11px] leading-relaxed relative flex flex-col\">\n                <div className=\"mb-4 pb-2 border-b border-neutral-900 text-neutral-500 uppercase\">Source Trace</div>\n                <div className=\"flex-1\">\n                  <p className=\"text-green-500 mb-1\">&gt; init --precision high</p>\n                  <p className=\"mb-1 text-neutral-300\">[INFO] Loading memory_ccmf.json...</p>\n                  <p className=\"mb-1 text-neutral-300\">[OK] No deviations found.</p>\n                  <p className=\"mb-1 text-neutral-300\">[OK] Verbatim policy verified.</p>\n                  <p className=\"text-neutral-500 mt-4\">READY FOR INPUT_</p>\n                </div>\n                <div className=\"h-1 w-full bg-neutral-800 overflow-hidden\">\n                  <div className=\"h-full bg-white w-1/3\"></div>\n                </div>\n              </div>\n              <div className=\"bg-white text-black p-10 flex flex-col justify-center items-center text-center\">\n                <div className=\"text-[10px] font-black uppercase tracking-[0.4em] mb-12 opacity-40\">Validation State</div>\n                <div className=\"text-6xl font-black leading-none mb-4\">STRICT<br/>PASS</div>\n                <div className=\"mt-8 pt-8 border-t border-neutral-200 w-full flex flex-col gap-2\">\n                  <div className=\"text-[9px] font-bold\">ASSERTION: ZERO_CHILLER_POLICY</div>\n                  <div className=\"text-[9px] font-bold\">ASSERTION: RAW_LOG_INTEGRITY</div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </main>\n      </div>\n      <footer className=\"h-20 bg-neutral-900 border-t border-neutral-800 flex items-center px-8 font-mono text-[9px] text-neutral-500 uppercase tracking-[0.25em]\">\n        <div className=\"flex-1\">Engineering_Assistant_v2.0.4.19</div>\n        <div className=\"flex gap-12 text-neutral-400\">\n          <div className=\"flex gap-2\"><span className=\"text-neutral-600\">Uptime:</span> 14:42:01</div>\n          <div className=\"flex gap-2\"><span className=\"text-neutral-600\">Mode:</span> Precision_A</div>\n          <div className=\"flex gap-2\"><span className=\"text-white\">Deviations:</span> <span className=\"text-green-500 font-bold\">00</span></div>\n        </div>\n      </footer>\n    </div>\n  );\n}"
    }
