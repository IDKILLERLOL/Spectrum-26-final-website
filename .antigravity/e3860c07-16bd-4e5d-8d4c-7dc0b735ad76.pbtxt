      replacement_content: "import { Plus, Search, Trash2, ShieldAlert, Key } from \'lucide-react\';\n\nexport function AdminUsersPage() {\n  return (\n    <div className=\"w-full flex-1 flex flex-col bg-bg-elevated px-6 py-12 md:py-24\">\n      <div className=\"w-full max-w-[1200px] mx-auto flex flex-col gap-12\">\n        \n        {/* Header */}\n        <div className=\"flex flex-col gap-4\">\n          <div className=\"flex items-center gap-4 text-red-500 text-micro uppercase tracking-widest font-bold\">\n            <span className=\"w-12 h-[1px] bg-red-500/50\"></span> \n            Access Control\n          </div>\n          <h1 className=\"text-hero text-text-primary uppercase tracking-tighter leading-none select-none\">\n            Administrators\n          </h1>\n        </div>\n\n        {/* Controls */}\n        <div className=\"flex flex-col md:flex-row gap-4 justify-between items-center bg-bg-card p-6 border border-border-default\">\n          <div className=\"relative w-full md:w-96\">\n            <Search className=\"absolute left-4 top-1/2 -translate-y-1/2 text-text-muted\" size={16} />\n            <input type=\"text\" placeholder=\"SEARCH IDENTITIES...\" className=\"w-full bg-bg-elevated border border-border-strong pl-12 pr-4 py-3 text-small text-text-primary placeholder:text-text-muted focus:outline-none focus:border-text-primary transition-colors uppercase tracking-widest\" />\n          </div>\n          <button className=\"w-full md:w-auto flex items-center justify-center gap-2 bg-text-primary text-bg-base text-button px-6 py-4 hover:bg-text-secondary transition-colors uppercase tracking-widest\">\n            <Plus size={16} /> Grant Clearance\n          </button>\n        </div>\n\n        {/* Table */}\n        <div className=\"bg-bg-card border border-border-default overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"border-b border-border-strong text-micro text-text-muted uppercase tracking-widest bg-bg-elevated\">\n                <th className=\"p-6 font-normal\">Identity ID</th>\n                <th className=\"p-6 font-normal\">Clearance Level</th>\n                <th className=\"p-6 font-normal\">Status</th>\n                <th className=\"p-6 font-normal text-right\">Revoke</th>\n              </tr>\n            </thead>\n            <tbody className=\"text-body text-text-secondary divide-y divide-border-subtle\">\n              <AdminUserRow id=\"SYS-ADMIN-01\" level=\"Tier 1 / Root\" status=\"Active\" statusColor=\"text-green-500\" />\n              <AdminUserRow id=\"MOD-A2\" level=\"Tier 2 / Events\" status=\"Active\" statusColor=\"text-green-500\" />\n              <AdminUserRow id=\"MOD-B4\" level=\"Tier 2 / Events\" status=\"Suspended\" statusColor=\"text-red-500\" />\n              <AdminUserRow id=\"LOG-01\" level=\"Tier 3 / Logistics\" status=\"Active\" statusColor=\"text-green-500\" />\n            </tbody>\n          </table>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n\nfunction AdminUserRow({ id, level, status, statusColor }: { id: string, level: string, status: string, statusColor: string }) {\n  return (\n    <tr className=\"hover:bg-bg-card-hover transition-colors group\">\n      <td className=\"p-6 font-mono text-small text-text-primary\">{id}</td>\n      <td className=\"p-6 text-small uppercase tracking-widest flex items-center gap-2\"><Key size={14} className=\"text-text-muted\"/> {level}</td>\n      <td className={`p-6 text-micro uppercase tracking-widest font-bold ${statusColor}`}>{status}</td>\n      <td className=\"p-6 text-right\">\n        <div className=\"flex justify-end gap-3 opacity-50 group-hover:opacity-100 transition-opacity\">\n          <button className=\"text-text-muted hover:text-red-500 transition-colors p-2\" title=\"Revoke Access\"><Trash2 size={16} /></button>\n        </div>\n      </td>\n    </tr>\n  );\n}"
    }
