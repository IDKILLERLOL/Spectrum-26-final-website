      replacement_content: "import { MapPin, Clock, Users, Calendar, ChevronLeft, ShieldAlert } from \'lucide-react\';\nimport { Link, useParams } from \'react-router-dom\';\n\nexport function EventDetailPage() {\n  const { id } = useParams();\n\n  return (\n    <div className=\"w-full flex-1 flex flex-col bg-bg-elevated px-6 py-12 md:py-24\">\n      <div className=\"w-full max-w-[1200px] mx-auto flex flex-col gap-12\">\n        \n        {/* Back navigation */}\n        <div>\n          <Link to=\"/\" className=\"inline-flex items-center gap-2 text-micro text-text-muted hover:text-text-primary uppercase tracking-widest transition-colors\">\n            <ChevronLeft size={16} /> Return to Directory\n          </Link>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-12\">\n          {/* Main Info */}\n          <div className=\"lg:col-span-2 flex flex-col gap-8\">\n            <div className=\"flex flex-col gap-6\">\n              <div className=\"flex items-center gap-4\">\n                <span className=\"border border-text-primary text-text-primary px-3 py-1 text-micro uppercase tracking-widest\">\n                  E-Sports\n                </span>\n                <span className=\"flex items-center gap-2 text-green-500 text-micro uppercase tracking-widest\">\n                  <span className=\"w-2 h-2 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.6)]\"></span>\n                  Registration Open\n                </span>\n              </div>\n              \n              <h1 className=\"text-hero text-text-primary uppercase tracking-tighter leading-none select-none\">\n                BGMI <br/> Qualifiers\n              </h1>\n              \n              <p className=\"text-body text-text-secondary text-lg mt-4 max-w-2xl\">\n                Squad up. Drop in. Survive. Tactical coordination and raw aiming skill in the ultimate arena. The first phase of the tournament determines the top 16 squads moving to the grand finals.\n              </p>\n            </div>\n\n            {/* Metrics */}\n            <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 py-8 border-y border-border-default\">\n              <div className=\"flex flex-col gap-2\">\n                <span className=\"text-micro text-text-muted uppercase\">Date</span>\n                <span className=\"text-heading text-text-primary flex items-center gap-2\"><Calendar size={16}/> Day 1</span>\n              </div>\n              <div className=\"flex flex-col gap-2\">\n                <span className=\"text-micro text-text-muted uppercase\">Time</span>\n                <span className=\"text-heading text-text-primary flex items-center gap-2\"><Clock size={16}/> 14:00</span>\n              </div>\n              <div className=\"flex flex-col gap-2\">\n                <span className=\"text-micro text-text-muted uppercase\">Location</span>\n                <span className=\"text-heading text-text-primary flex items-center gap-2\"><MapPin size={16}/> E-Sports Hub</span>\n              </div>\n              <div className=\"flex flex-col gap-2\">\n                <span className=\"text-micro text-text-muted uppercase\">Team Size</span>\n                <span className=\"text-heading text-text-primary flex items-center gap-2\"><Users size={16}/> 4 Players</span>\n              </div>\n            </div>\n\n            {/* Rules */}\n            <div className=\"flex flex-col gap-6\">\n              <h3 className=\"text-card-title text-text-primary uppercase tracking-widest\">Engagement Rules</h3>\n              <ul className=\"flex flex-col gap-4 text-body text-text-secondary list-disc pl-5\">\n                <li>All players must use provided tournament devices. Personal devices are strictly prohibited.</li>\n                <li>Exploiting known glitches or bugs will result in immediate squad disqualification.</li>\n                <li>Standard Erangel map. Weather dynamic.</li>\n                <li>Toxic behavior in all-chat is a violation of the code of conduct.</li>\n              </ul>\n            </div>\n          </div>\n\n          {/* Sidebar */}\n          <div className=\"lg:col-span-1 flex flex-col gap-8\">\n            <div className=\"bg-bg-card border border-border-default p-8 flex flex-col gap-6\">\n              <h3 className=\"text-card-title text-text-primary uppercase tracking-widest\">Status</h3>\n              \n              <div className=\"flex flex-col gap-2\">\n                <div className=\"flex justify-between text-micro text-text-muted uppercase\">\n                  <span>Capacity</span>\n                  <span>42 / 64 Squads</span>\n                </div>\n                <div className=\"w-full h-1 bg-border-strong overflow-hidden\">\n                  <div className=\"h-full bg-text-primary w-[65%]\"></div>\n                </div>\n              </div>\n\n              <div className=\"flex flex-col gap-4 mt-4\">\n                <button className=\"w-full bg-text-primary text-bg-base text-button py-4 hover:bg-text-secondary transition-colors uppercase tracking-widest\">\n                  Execute Registration\n                </button>\n                <button className=\"w-full bg-transparent border border-border-strong text-text-primary text-button py-4 hover:bg-bg-card-hover transition-colors uppercase tracking-widest\">\n                  View Squads\n                </button>\n              </div>\n            </div>\n\n            <div className=\"bg-red-900/10 border border-red-900/30 p-6 flex items-start gap-4 text-red-500\">\n              <ShieldAlert size={24} className=\"shrink-0 mt-1\" />\n              <div className=\"flex flex-col gap-2\">\n                <span className=\"text-heading uppercase tracking-widest\">Strict Protocol</span>\n                <span className=\"text-small text-red-500/70\">Registration closes 2 hours before event initialization. No exceptions.</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}"
    }
