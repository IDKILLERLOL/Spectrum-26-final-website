      target_content: "import { Cpu, Gamepad2 } from \'lucide-react\';\n\nconst techEvents = [\n  { title: \'Reverse Engineering\', category: \'Logic\', desc: \'Deconstruct compiled binaries to understand pure logic architecture. Speed and accuracy define the victor.\', img: \'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&q=80&w=800&grayscale=true\' },\n  { title: \'Speed Typing\', category: \'Reflex\', desc: \'Raw WPM vs flawless syntax. A mechanical sprint through complex code blocks under pressure.\', img: \'https://images.unsplash.com/photo-1595225476474-87563907a212?auto=format&fit=crop&q=80&w=800&grayscale=true\' },\n  { title: \'Code Prism\', category: \'Algorithms\', desc: \'Competitive programming challenge focusing on algorithmic efficiency and data structure optimization.\', img: \'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&q=80&w=800&grayscale=true\' }\n];\n\nconst nonTechEvents = [\n  { title: \'BGMI\', category: \'E-Sports\', desc: \'Squad up. Drop in. Survive. Tactical coordination and raw aiming skill in the ultimate arena.\', img: \'https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&q=80&w=800&grayscale=true\' },\n  { title: \'Free Fire\', category: \'E-Sports\', desc: \'Fast-paced, high-stakes combat. Dominate the skirmish and outlast the competition.\', img: \'https://images.unsplash.com/photo-1612287230202-1ff1d85d1bdf?auto=format&fit=crop&q=80&w=800&grayscale=true\' },\n  { title: \'FC 26\', category: \'Simulation\', desc: \'The ultimate digital pitch. Bring your tactical formations and flawless execution to the tournament.\', img: \'https://images.unsplash.com/photo-1518605368461-1ee711659208?auto=format&fit=crop&q=80&w=800&grayscale=true\' }\n];\n\nexport function Events() {\n  return (\n    <section id=\"events\" className=\"w-full py-16 md:py-24 px-6 max-w-[1200px] mx-auto flex flex-col gap-16\">\n      <EventGroup title=\"Tech Events\" icon={<Cpu size={32} />} events={techEvents} isDashed={false} />\n      <EventGroup title=\"Non-Tech Events\" icon={<Gamepad2 size={32} />} events={nonTechEvents} isDashed={true} />\n    </section>\n  );\n}\n\nfunction EventGroup({ title, icon, events, isDashed }: { title: string, icon: React.ReactNode, events: any[], isDashed: boolean }) {\n  return (\n    <div className=\"flex flex-col gap-8\">\n      <div className=\"flex items-center gap-6 border-b border-border-default pb-4 text-text-primary\">\n        {icon}\n        <h2 className=\"text-section uppercase tracking-tighter\">{title}</h2>\n      </div>\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n        {events.map((e, i) => (\n          <EventCard key={i} {...e} isDashed={isDashed} />\n        ))}\n      </div>\n    </div>\n  );\n}\n\nfunction EventCard({ title, category, desc, img, isDashed }: { title: string, category: string, desc: string, img: string, isDashed: boolean }) {\n  const borderClass = isDashed ? \'border-dashed\' : \'border-solid\';\n  const tagClass = isDashed ? \'bg-transparent text-text-primary border border-text-primary\' : \'bg-text-primary text-bg-base\';\n  const btnClass = isDashed ? \'bg-transparent border border-text-primary text-text-primary hover:bg-text-primary hover:text-bg-base\' : \'bg-text-primary text-bg-base hover:bg-text-secondary\';\n  \n  return (\n    <div className={`group bg-bg-card hover:bg-bg-card-hover border ${borderClass} border-border-default p-4 md:p-6 flex flex-col justify-between gap-6 transition-all hover:scale-[1.02]`}>\n      <div className=\"flex flex-col gap-4\">\n        <div className={`h-40 w-full bg-bg-elevated border ${borderClass} border-border-subtle overflow-hidden`}>\n          <img src={img} alt={title} className=\"w-full h-full object-cover grayscale opacity-80 group-hover:opacity-100 transition-opacity\" />\n        </div>\n        <div>\n           <span className={`text-micro px-2 py-1 uppercase tracking-widest inline-block mb-3 ${tagClass}`}>\n             {category}\n           </span>\n           <h3 className=\"text-card-title text-text-primary uppercase\">{title}</h3>\n        </div>\n        <p className=\"text-body text-text-secondary line-clamp-2\">{desc}</p>\n      </div>\n      <button className={`w-full text-button px-6 py-4 uppercase tracking-widest transition-colors ${btnClass}`}>\n        Register\n      </button>\n    </div>\n  );\n}"
      replacement_content: "import { Cpu, Gamepad2 } from \'lucide-react\';\nimport { Link } from \'react-router-dom\';\n\nconst techEvents = [\n  { id: \'tech-1\', title: \'Reverse Engineering\', category: \'Logic\', desc: \'Deconstruct compiled binaries to understand pure logic architecture. Speed and accuracy define the victor.\', img: \'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&q=80&w=800&grayscale=true\' },\n  { id: \'tech-2\', title: \'Speed Typing\', category: \'Reflex\', desc: \'Raw WPM vs flawless syntax. A mechanical sprint through complex code blocks under pressure.\', img: \'https://images.unsplash.com/photo-1595225476474-87563907a212?auto=format&fit=crop&q=80&w=800&grayscale=true\' },\n  { id: \'tech-3\', title: \'Code Prism\', category: \'Algorithms\', desc: \'Competitive programming challenge focusing on algorithmic efficiency and data structure optimization.\', img: \'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&q=80&w=800&grayscale=true\' }\n];\n\nconst nonTechEvents = [\n  { id: \'non-tech-1\', title: \'BGMI\', category: \'E-Sports\', desc: \'Squad up. Drop in. Survive. Tactical coordination and raw aiming skill in the ultimate arena.\', img: \'https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&q=80&w=800&grayscale=true\' },\n  { id: \'non-tech-2\', title: \'Free Fire\', category: \'E-Sports\', desc: \'Fast-paced, high-stakes combat. Dominate the skirmish and outlast the competition.\', img: \'https://images.unsplash.com/photo-1612287230202-1ff1d85d1bdf?auto=format&fit=crop&q=80&w=800&grayscale=true\' },\n  { id: \'non-tech-3\', title: \'FC 26\', category: \'Simulation\', desc: \'The ultimate digital pitch. Bring your tactical formations and flawless execution to the tournament.\', img: \'https://images.unsplash.com/photo-1518605368461-1ee711659208?auto=format&fit=crop&q=80&w=800&grayscale=true\' }\n];\n\nexport function Events() {\n  return (\n    <section id=\"events\" className=\"w-full py-16 md:py-24 px-6 max-w-[1200px] mx-auto flex flex-col gap-16\">\n      <EventGroup title=\"Tech Events\" icon={<Cpu size={32} />} events={techEvents} isDashed={false} />\n      <EventGroup title=\"Non-Tech Events\" icon={<Gamepad2 size={32} />} events={nonTechEvents} isDashed={true} />\n    </section>\n  );\n}\n\nfunction EventGroup({ title, icon, events, isDashed }: { title: string, icon: React.ReactNode, events: any[], isDashed: boolean }) {\n  return (\n    <div className=\"flex flex-col gap-8\">\n      <div className=\"flex items-center gap-6 border-b border-border-default pb-4 text-text-primary\">\n        {icon}\n        <h2 className=\"text-section uppercase tracking-tighter\">{title}</h2>\n      </div>\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n        {events.map((e, i) => (\n          <EventCard key={i} {...e} isDashed={isDashed} />\n        ))}\n      </div>\n    </div>\n  );\n}\n\nfunction EventCard({ id, title, category, desc, img, isDashed }: { id: string, title: string, category: string, desc: string, img: string, isDashed: boolean }) {\n  const borderClass = isDashed ? \'border-dashed\' : \'border-solid\';\n  const tagClass = isDashed ? \'bg-transparent text-text-primary border border-text-primary\' : \'bg-text-primary text-bg-base\';\n  const btnClass = isDashed ? \'bg-transparent border border-text-primary text-text-primary hover:bg-text-primary hover:text-bg-base\' : \'bg-text-primary text-bg-base hover:bg-text-secondary\';\n  \n  return (\n    <div className={`group bg-bg-card hover:bg-bg-card-hover border ${borderClass} border-border-default p-4 md:p-6 flex flex-col justify-between gap-6 transition-all hover:scale-[1.02]`}>\n      <div className=\"flex flex-col gap-4\">\n        <div className={`h-40 w-full bg-bg-elevated border ${borderClass} border-border-subtle overflow-hidden`}>\n          <img src={img} alt={title} className=\"w-full h-full object-cover grayscale opacity-80 group-hover:opacity-100 transition-opacity\" />\n        </div>\n        <div>\n           <span className={`text-micro px-2 py-1 uppercase tracking-widest inline-block mb-3 ${tagClass}`}>\n             {category}\n           </span>\n           <h3 className=\"text-card-title text-text-primary uppercase\">{title}</h3>\n        </div>\n        <p className=\"text-body text-text-secondary line-clamp-2\">{desc}</p>\n      </div>\n      <Link to={`/events/${id}`} className={`w-full text-center text-button px-6 py-4 uppercase tracking-widest transition-colors ${btnClass}`}>\n        View Details\n      </Link>\n    </div>\n  );\n}"
