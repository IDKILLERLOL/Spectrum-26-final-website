      replacement_content: "import { Trophy, Search, ChevronDown, Download } from \'lucide-react\';\n\nexport function AdminWinnersPage() {\n  return (\n    <div className=\"w-full flex-1 flex flex-col bg-bg-elevated px-6 py-12 md:py-24\">\n      <div className=\"w-full max-w-[1200px] mx-auto flex flex-col gap-12\">\n        \n        {/* Header */}\n        <div className=\"flex flex-col gap-4\">\n          <div className=\"flex items-center gap-4 text-red-500 text-micro uppercase tracking-widest font-bold\">\n            <span className=\"w-12 h-[1px] bg-red-500/50\"></span> \n            Results Archive\n          </div>\n          <h1 className=\"text-hero text-text-primary uppercase tracking-tighter leading-none select-none\">\n            Festival Winners\n          </h1>\n        </div>\n\n        {/* Controls */}\n        <div className=\"flex flex-col md:flex-row gap-4 justify-between items-center bg-bg-card p-6 border border-border-default\">\n          <div className=\"relative w-full md:w-96\">\n            <Search className=\"absolute left-4 top-1/2 -translate-y-1/2 text-text-muted\" size={16} />\n            <input type=\"text\" placeholder=\"SEARCH ENTITIES...\" className=\"w-full bg-bg-elevated border border-border-strong pl-12 pr-4 py-3 text-small text-text-primary placeholder:text-text-muted focus:outline-none focus:border-text-primary transition-colors uppercase tracking-widest\" />\n          </div>\n          <div className=\"flex gap-4 w-full md:w-auto\">\n            <button className=\"flex-1 md:flex-none flex items-center justify-center gap-2 bg-transparent border border-border-strong text-text-primary text-button px-6 py-4 hover:bg-bg-card-hover transition-colors uppercase tracking-widest\">\n              Filter <ChevronDown size={16} />\n            </button>\n            <button className=\"flex-1 md:flex-none flex items-center justify-center gap-2 bg-text-primary text-bg-base text-button px-6 py-4 hover:bg-text-secondary transition-colors uppercase tracking-widest\">\n              <Download size={16} /> Export Data\n            </button>\n          </div>\n        </div>\n\n        {/* Table */}\n        <div className=\"bg-bg-card border border-border-default overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"border-b border-border-strong text-micro text-text-muted uppercase tracking-widest bg-bg-elevated\">\n                <th className=\"p-6 font-normal\">Placement</th>\n                <th className=\"p-6 font-normal\">Event</th>\n                <th className=\"p-6 font-normal\">Entity Name</th>\n                <th className=\"p-6 font-normal\">Score/Time</th>\n              </tr>\n            </thead>\n            <tbody className=\"text-body text-text-secondary divide-y divide-border-subtle\">\n              <WinnerRow placement=\"1ST\" event=\"BGMI Qualifiers\" entity=\"Squad Alpha\" score=\"1240 PT\" color=\"text-yellow-400\" />\n              <WinnerRow placement=\"2ND\" event=\"BGMI Qualifiers\" entity=\"Echo Team\" score=\"1120 PT\" color=\"text-neutral-300\" />\n              <WinnerRow placement=\"3RD\" event=\"BGMI Qualifiers\" entity=\"Delta Force\" score=\"980 PT\" color=\"text-amber-600\" />\n              <WinnerRow placement=\"1ST\" event=\"Reverse Engineering\" entity=\"J. Doe\" score=\"00:14:22\" color=\"text-yellow-400\" />\n            </tbody>\n          </table>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n\nfunction WinnerRow({ placement, event, entity, score, color }: { placement: string, event: string, entity: string, score: string, color: string }) {\n  return (\n    <tr className=\"hover:bg-bg-card-hover transition-colors\">\n      <td className={`p-6 font-bold text-small uppercase tracking-widest flex items-center gap-2 ${color}`}>\n        <Trophy size={16} /> {placement}\n      </td>\n      <td className=\"p-6 text-small text-text-primary uppercase tracking-widest\">{event}</td>\n      <td className=\"p-6 font-mono text-small\">{entity}</td>\n      <td className=\"p-6 font-mono text-small text-text-primary\">{score}</td>\n    </tr>\n  );\n}"
    }
