        replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800;900&family=Oxanium:wght@500;600;700&family=Inter:wght@400;500;600&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --color-bg-base: #000000;\n  --color-bg-elevated: #0a0a0a;\n  --color-bg-card: #111111;\n  --color-bg-card-hover: #1a1a1a;\n  --color-border-subtle: rgba(255, 255, 255, 0.06);\n  --color-border-default: rgba(255, 255, 255, 0.10);\n  --color-border-strong: rgba(255, 255, 255, 0.20);\n  --color-text-primary: #ffffff;\n  --color-text-secondary: rgba(255, 255, 255, 0.55);\n  --color-text-muted: rgba(255, 255, 255, 0.35);\n\n  --font-hero: \"Orbitron\", sans-serif;\n  --font-heading: \"Oxanium\", sans-serif;\n  --font-body: \"Inter\", sans-serif;\n}\n\nbody {\n  background-color: var(--color-bg-base);\n  color: var(--color-text-primary);\n  font-family: var(--font-body);\n  overflow-x: hidden;\n}\n\n@utility text-hero {\n  font-family: var(--font-hero);\n  font-size: clamp(48px, 9vw, 104px);\n  font-weight: 900;\n  line-height: 1.1;\n  letter-spacing: 0.05em;\n}\n@utility text-countdown {\n  font-family: var(--font-hero);\n  font-size: clamp(36px, 6vw, 64px);\n  font-weight: 800;\n  line-height: 1.2;\n}\n@utility text-section {\n  font-family: var(--font-hero);\n  font-size: clamp(28px, 4vw, 44px);\n  font-weight: 800;\n  line-height: 1.2;\n}\n@utility text-card-title {\n  font-family: var(--font-heading);\n  font-size: 20px;\n  font-weight: 700;\n  line-height: 1.4;\n}\n@utility text-heading {\n  font-family: var(--font-heading);\n  font-size: 16px;\n  font-weight: 600;\n  line-height: 1.2;\n}\n@utility text-button {\n  font-family: var(--font-heading);\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 1;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n@utility text-body {\n  font-family: var(--font-body);\n  font-size: 15px;\n  font-weight: 400;\n  line-height: 1.6;\n}\n@utility text-small {\n  font-family: var(--font-body);\n  font-size: 13px;\n  font-weight: 400;\n  line-height: 1.4;\n}\n@utility text-micro {\n  font-family: var(--font-body);\n  font-size: 11px;\n  font-weight: 500;\n  line-height: 1;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n@utility text-glow {\n  text-shadow: 0 0 30px rgba(255, 255, 255, 0.30);\n}"
