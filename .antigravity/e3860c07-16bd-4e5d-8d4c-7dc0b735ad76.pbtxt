py-3 text-small text-text-primary placeholder:text-text-muted focus:outline-none focus:border-text-primary transition-colors uppercase tracking-widest\" />\n          </div>\n        </div>\n\n        {/* Schedule Grid */}\n        <div className=\"flex flex-col border border-border-default bg-bg-card\">\n          <ScheduleRow time=\"09:00\" title=\"Check-in & Registration\" location=\"Main Terminal\" type=\"Logistics\" />\n          <ScheduleRow time=\"10:00\" title=\"Opening Protocol\" location=\"Alpha Arena\" type=\"Ceremony\" active />\n          <ScheduleRow time=\"11:30\" title=\"Reverse Engineering\" location=\"Lab 04\" type=\"Tech Event\" />\n          <ScheduleRow time=\"13:00\" title=\"System Refuel (Lunch)\" location=\"Zone B\" type=\"Break\" />\n          <ScheduleRow time=\"14:00\" title=\"BGMI Qualifiers\" location=\"E-Sports Hub\" type=\"Non-Tech Event\" />\n          <ScheduleRow time=\"16:30\" title=\"Code Prism Phase 1\" location=\"Lab 01\" type=\"Tech Event\" />\n          <ScheduleRow time=\"19:00\" title=\"Day 1 Termination\" location=\"Main Terminal\" type=\"Logistics\" />\n        </div>\n\n      </div>\n    </div>\n  );\n}\n\nfunction ScheduleRow({ time, title, location, type, active = false }: { time: string, title: string, location: string, type: string, active?: boolean }) {\n  const rowClass = active ? \"border-l-4 border-l-green-500 bg-bg-card-hover\" : \"border-l-4 border-l-transparent hover:bg-bg-card-hover\";\n  const titleClass = active ? \"text-green-500 text-glow\" : \"text-text-primary\";\n  \n  return (\n    <div className={`grid grid-cols-1 md:grid-cols-12 gap-4 p-6 border-b border-border-subtle last:border-0 transition-colors ${rowClass}`}>\n      <div className=\"md:col-span-2 flex items-center font-hero text-section text-text-secondary\">\n        {time}\n      </div>\n      <div className=\"md:col-span-6 flex flex-col justify-center gap-2\">\n        <h3 className={`text-card-title uppercase tracking-widest ${titleClass}`}>{title}</h3>\n        <div className=\"flex items-center gap-4 text-micro text-text-muted uppercase\">\n          <span className=\"flex items-center gap-1\"><MapPin size={12}/> {location}</span>\n          <span className=\"flex items-center gap-1\"><Clock size={12}/> 90 MIN</span>\n        </div>\n      </div>\n      <div className=\"md:col-span-3 flex items-center\">\n        <span className=\"border border-border-strong px-3 py-1 text-micro text-text-secondary uppercase tracking-widest\">\n          {type}\n        </span>\n      </div>\n      <div className=\"md:col-span-1 flex items-center justify-end\">\n        <button className=\"text-text-muted hover:text-text-primary transition-colors\">\n          <ChevronRight size={24} />\n        </button>\n      </div>\n    </div>\n  );\n}"
    }
