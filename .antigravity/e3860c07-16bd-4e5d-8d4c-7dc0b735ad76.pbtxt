      replacement_content: "import { Link, useLocation } from \'react-router-dom\';\n\nexport function Sidebar() {\n  const location = useLocation();\n  const isAdmin = location.pathname.startsWith(\'/admin\');\n\n  return (\n    <aside className=\"hidden md:flex w-72 border-r border-border-default flex-col bg-bg-base shrink-0 overflow-y-auto\">\n      <div className=\"p-6 border-b border-border-default\">\n        <span className=\"text-[10px] font-bold uppercase tracking-[0.2em] text-text-muted\">System Navigation</span>\n      </div>\n      <div className=\"flex-1 p-6 font-mono text-xs space-y-6 text-text-secondary\">\n        <div className=\"space-y-2 flex flex-col\">\n          {!isAdmin ? (\n            <>\n              <div className=\"text-text-muted mb-2\">/ root / user /</div>\n              <SidebarLink to=\"/\" label=\"Events_Catalog.exe\" active={location.pathname === \'/\'} />\n              <SidebarLink to=\"/schedule\" label=\"Chronology.log\" active={location.pathname === \'/schedule\'} />\n              <SidebarLink to=\"/registrations\" label=\"My_Clearances.dat\" active={location.pathname === \'/registrations\'} />\n            </>\n          ) : (\n            <>\n              <div className=\"text-text-muted mb-2\">/ root / admin /</div>\n              <SidebarLink to=\"/admin/events\" label=\"Manage_Catalog.exe\" active={location.pathname === \'/admin/events\'} />\n              <SidebarLink to=\"/admin/users\" label=\"Access_Control.sys\" active={location.pathname === \'/admin/users\'} />\n              <SidebarLink to=\"/admin/winners\" label=\"Results_Archive.dat\" active={location.pathname === \'/admin/winners\'} />\n              <SidebarLink to=\"/admin/audit-log\" label=\"syslog_stream.sh\" active={location.pathname === \'/admin/audit-log\'} />\n            </>\n          )}\n        </div>\n        \n        <div className=\"pt-12 space-y-4\">\n          <div className=\"p-3 bg-bg-elevated border-l-4 border-text-primary\">\n            <div className=\"text-[9px] text-text-muted mb-1 uppercase\">Directive Alpha</div>\n            <div className=\"text-text-primary font-bold\">VERBATIM_ONLY</div>\n          </div>\n          <div className=\"p-3 border-l-4 border-border-strong opacity-40\">\n            <div className=\"text-[9px] text-text-muted mb-1 uppercase\">Directive Beta</div>\n            <div className=\"text-text-secondary\">ZERO_INFERENCE</div>\n          </div>\n        </div>\n      </div>\n    </aside>\n  );\n}\n\nfunction SidebarLink({ to, label, active }: { to: string, label: string, active: boolean }) {\n  return (\n    <Link to={to} className={`pl-3 py-2 border-l transition-colors ${active ? \'border-text-primary text-text-primary\' : \'border-transparent text-text-muted hover:text-text-secondary hover:border-border-strong\'}`}>\n      {label}\n    </Link>\n  );\n}\n"
    }
