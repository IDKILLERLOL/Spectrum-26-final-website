  file_change {
    absolute_path_uri: "file:///src/pages/AdminEventsPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { Plus, Search, Edit2, Trash2, ShieldAlert } from \'lucide-react\';\n\nexport function AdminEventsPage() {\n  return (\n    <div className=\"w-full flex-1 flex flex-col bg-bg-elevated px-6 py-12 md:py-24\">\n      <div className=\"w-full max-w-[1200px] mx-auto flex flex-col gap-12\">\n        \n        {/* Header */}\n        <div className=\"flex flex-col gap-4\">\n          <div className=\"flex items-center gap-4 text-red-500 text-micro uppercase tracking-widest font-bold\">\n            <span className=\"w-12 h-[1px] bg-red-500/50\"></span> \n            System Administration\n          </div>\n          <h1 className=\"text-hero text-text-primary uppercase tracking-tighter leading-none select-none\">\n            Events Catalog\n          </h1>\n        </div>\n\n        {/* Controls */}\n        <div className=\"flex flex-col md:flex-row gap-4 justify-between items-center bg-bg-card p-6 border border-border-default\">\n          <div className=\"relative w-full md:w-96\">\n            <Search className=\"absolute left-4 top-1/2 -translate-y-1/2 text-text-muted\" size={16} />\n            <input type=\"text\" placeholder=\"SEARCH CATALOG...\" className=\"w-full bg-bg-elevated border border-border-strong pl-12 pr-4 py-3 text-small text-text-primary placeholder:text-text-muted focus:outline-none focus:border-text-primary transition-colors uppercase tracking-widest\" />\n          </div>\n          <button className=\"w-full md:w-auto flex items-center justify-center gap-2 bg-text-primary text-bg-base text-button px-6 py-4 hover:bg-text-secondary transition-colors uppercase tracking-widest\">\n            <Plus size={16} /> Init Event\n          </button>\n        </div>\n\n        {/* Table */}\n        <div className=\"bg-bg-card border border-border-default overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"border-b border-border-strong text-micro text-text-muted uppercase tracking-widest bg-bg-elevated\">\n                <th className=\"p-6 font-normal\">ID</th>\n                <th className=\"p-6 font-normal\">Event Title</th>\n                <th className=\"p-6 font-normal\">Category</th>\n                <th className=\"p-6 font-normal\">Capacity</th>\n                <th className=\"p-6 font-normal\">Status</th>\n                <th className=\"p-6 font-normal text-right\">Actions</th>\n              </tr>\n            </thead>\n            <tbody className=\"text-body text-text-secondary divide-y divide-border-subtle\">\n              <AdminEventRow id=\"EVT-01\" title=\"BGMI Qualifiers\" category=\"E-Sports\" capacity=\"42/64\" status=\"Active\" statusColor=\"text-green-500\" />\n              <AdminEventRow id=\"EVT-02\" title=\"Reverse Engineering\" category=\"Tech Event\" capacity=\"28/30\" status=\"Active\" statusColor=\"text-green-500\" />\n              <AdminEventRow id=\"EVT-03\" title=\"Code Prism Phase 1\" category=\"Tech Event\" capacity=\"120/150\" status=\"Active\" statusColor=\"text-green-500\" />\n              <AdminEventRow id=\"EVT-04\" title=\"Speed Typing\" category=\"Tech Event\" capacity=\"0/50\" status=\"Pending\" statusColor=\"text-yellow-500\" />\n            </tbody>\n          </table>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n\nfunction AdminEventRow({ id, title, category, capacity, status, statusColor }: { id: string, title: string, category: string, capacity: string, status: string, statusColor: string }) {\n  return (\n    <tr className=\"hover:bg-bg-card-hover transition-colors group\">\n      <td className=\"p-6 font-mono text-small text-text-muted\">{id}</td>\n      <td className=\"p-6 font-bold text-text-primary uppercase tracking-widest\">{title}</td>\n      <td className=\"p-6 text-small uppercase tracking-widest\">{category}</td>\n      <td className=\"p-6 font-mono text-small\">{capacity}</td>\n      <td className={`p-6 text-micro uppercase tracking-widest font-bold ${statusColor}`}>{status}</td>\n      <td className=\"p-6 text-right\">\n        <div className=\"flex justify-end gap-3 opacity-50 group-hover:opacity-100 transition-opacity\">\n          <button className=\"text-text-muted hover:text-text-primary transition-colors p-2\"><Edit2 size={16} /></button>\n          <button className=\"text-text-muted hover:text-red-500 transition-colors p-2\"><Trash2 size={16} /></button>\n        </div>\n      </td>\n    </tr>\n  );\n}"
    }
