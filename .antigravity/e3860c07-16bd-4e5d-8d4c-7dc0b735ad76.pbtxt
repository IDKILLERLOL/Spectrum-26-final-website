e=\"ROUTER\" message=\"Route generated for /admin/audit-log\" />\n            <LogEntry time=\"14:12:00\" level=\"INFO\" source=\"SYS_CRON\" message=\"Periodic backup completed. Checksum: 0xFFA24B00\" />\n            <div className=\"mt-4 flex items-center gap-2 text-green-500 animate-pulse\">\n              <span className=\"w-2 h-2 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.6)]\"></span>\n              Awaiting further input...\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n\nfunction LogEntry({ time, level, source, message, color = \"text-text-secondary\" }: { time: string, level: string, source: string, message: string, color?: string }) {\n  return (\n    <div className={`flex items-start gap-4 hover:bg-bg-card-hover px-2 py-1 transition-colors ${color}`}>\n      <span className=\"text-text-muted shrink-0\">[{time}]</span>\n      <span className=\"shrink-0 w-16 font-bold\">{level}</span>\n      <span className=\"shrink-0 w-24 opacity-70\">[{source}]</span>\n      <span className=\"break-all\">{message}</span>\n    </div>\n  );\n}"
