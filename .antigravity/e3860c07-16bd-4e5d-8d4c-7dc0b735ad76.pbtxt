hed={false} />      <EventGroup title=\"Non-Tech Events\" icon={<Gamepad2 size={32} />} events={nonTechEvents} isDashed={true} />    </section>  );}function EventGroup({ title, icon, events, isDashed }: { title: string, icon: React.ReactNode, events: any[], isDashed: boolean }) {  return (    <div className=\"flex flex-col gap-8\">      <div className=\"flex items-center gap-6 border-b border-border-default pb-4 text-text-primary\">        {icon}        <h2 className=\"text-section uppercase tracking-wide\">{title}</h2>      </div>      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">        {events.map((e, i) => (          <EventCard key={i} {...e} isDashed={isDashed} />        ))}      </div>    </div>  );}function EventCard({ title, category, desc, img, isDashed }: { title: string, category: string, desc: string, img: string, isDashed: boolean }) {  const borderClass = isDashed ? \'border-dashed\' : \'border-solid\';  const tagClass = isDashed ? \'bg-transparent text-text-primary border border-text-primary\' : \'bg-text-primary text-bg-base\';  const btnClass = isDashed ? \'bg-transparent border border-text-primary text-text-primary hover:bg-text-primary hover:text-bg-base\' : \'bg-text-primary text-bg-base hover:bg-text-secondary\';    return (    <div className={`group bg-bg-card hover:bg-bg-card-hover border ${borderClass} border-border-default p-4 md:p-6 flex flex-col justify-between gap-6 transition-all hover:scale-[1.02]`}>      <div className=\"flex flex-col gap-4\">        <div className={`h-40 w-full bg-bg-elevated border ${borderClass} border-border-subtle overflow-hidden`}>          <img src={img} alt={title} className=\"w-full h-full object-cover grayscale opacity-80 group-hover:opacity-100 transition-opacity\" />        </div>        <div>           <span className={`text-micro px-2 py-1 uppercase tracking-widest inline-block mb-3 ${tagClass}`}>             {category}           </span>           <h3 className=\"text-card-title text-text-primary uppercase\">{title}</h3>        </div>        <p className=\"text-body text-text-secondary line-clamp-2\">{desc}</p>      </div>      <button className={`w-full text-button px-6 py-4 uppercase tracking-widest transition-colors ${btnClass}`}>        Register      </button>    </div>  );}"
