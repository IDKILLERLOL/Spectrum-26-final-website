    replacement_chunks {
      target_content: "import { Moon, User, LayoutDashboard, Calendar, Users, Trophy, ShieldAlert, FileText, Activity } from \'lucide-react\';\nimport { Link, useLocation } from \'react-router-dom\';\n\nexport function Navbar() {\n  const location = useLocation();\n  const isAdmin = location.pathname.startsWith(\'/admin\');\n\n  return (\n    <header className=\"w-full top-0 sticky bg-bg-base z-50 border-b border-border-default\">\n      <div className=\"flex flex-col\">\n        {isAdmin && (\n          <div className=\"w-full bg-red-900/20 text-red-500 text-micro py-2 px-6 border-b border-border-default flex justify-between items-center\">\n            <div className=\"flex items-center gap-2\">\n              <ShieldAlert size={14} />\n              <span>ADMINISTRATIVE OVERRIDE ACTIVE</span>\n            </div>\n            <Link to=\"/\" className=\"hover:text-text-primary transition-colors\">Return to standard view</Link>\n          </div>\n        )}\n        <div className=\"flex justify-between items-center px-6 py-4 max-w-[1200px] w-full mx-auto\">\n          <Link to={isAdmin ? \"/admin/events\" : \"/\"} className=\"font-hero text-card-title tracking-tighter text-text-primary uppercase flex items-center gap-4\">\n            SPECTRUM 26\n            {isAdmin && <span className=\"bg-red-500 text-black px-2 py-1 text-micro rounded-sm\">ADMIN</span>}\n          </Link>\n          <nav className=\"hidden md:flex gap-8 items-center\">\n            {!isAdmin ? (\n              <>\n                <Link to=\"/\" className={`text-heading hover:text-text-primary transition-colors ${location.pathname === \'/\' ? \'text-text-primary border-b-2 border-text-primary pb-1\' : \'text-text-secondary\'}`}>Events</Link>\n                <Link to=\"/schedule\" className={`text-heading hover:text-text-primary transition-colors ${location.pathname === \'/schedule\' ? \'text-text-primary border-b-2 border-text-primary pb-1\' : \'text-text-secondary\'}`}>Schedule</Link>\n                <Link to=\"/registrations\" className={`text-heading hover:text-text-primary transition-colors ${location.pathname === \'/registrations\' ? \'text-text-primary border-b-2 border-text-primary pb-1\' : \'text-text-secondary\'}`}>My Passes</Link>\n              </>\n            ) : (\n              <>\n                <Link to=\"/admin/events\" className={`flex items-center gap-2 text-heading hover:text-text-primary transition-colors ${location.pathname === \'/admin/events\' ? \'text-text-primary border-b-2 border-text-primary pb-1\' : \'text-text-secondary\'}`}><LayoutDashboard size={16}/> Catalog</Link>\n                <Link to=\"/admin/users\" className={`flex items-center gap-2 text-heading hover:text-text-primary transition-colors ${location.pathname === \'/admin/users\' ? \'text-text-primary border-b-2 border-text-primary pb-1\' : \'text-text-secondary\'}`}><Users size={16}/> Admins</Link>\n                <Link to=\"/admin/winners\" className={`flex items-center gap-2 text-heading hover:text-text-primary transition-colors ${location.pathname === \'/admin/winners\' ? \'text-text-primary border-b-2 border-text-primary pb-1\' : \'text-text-secondary\'}`}><Trophy size={16}/> Winners</Link>\n                <Link to=\"/admin/audit-log\" className={`flex items-center gap-2 text-heading hover:text-text-primary transition-colors ${location.pathname === \'/admin/audit-log\' ? \'text-text-primary border-b-2 border-text-primary pb-1\' : \'text-text-secondary\'}`}><Activity size={16}/> Audit</Link>\n              </>\n            )}\n          </nav>\n          <div className=\"flex gap-4 items-center\">\n            {!isAdmin && (\n              <Link to=\"/admin/events\" className=\"text-text-secondary hover:text-text-primary transition-colors mr-4\" title=\"Admin Portal\">\n                <ShieldAlert size={20} />\n              </Link>\n            )}\n            <button className=\"text-text-primary hover:text-text-secondary transition-colors\"><Moon size={20} /></button>\n            <button className=\"text-text-primary hover:text-text-secondary transition-colors\"><User size={20} /></button>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n}"
      replacement_content: "import { Link, useLocation } from \'react-router-dom\';\n\nexport function Navbar() {\n  const location = useLocation();\n  const isAdmin = location.pathname.startsWith(\'/admin\');\n\n  return (\n    <header className=\"border-b border-border-default flex flex-col justify-end p-6 md:p-8 bg-bg-base shrink-0 min-h-[120px] md:min-h-[160px] relative\">\n      {isAdmin && (\n        <div className=\"absolute top-0 left-0 w-full bg-red-900/20 text-red-500 text-micro py-2 px-6 border-b border-border-default flex justify-between items-center\">\n          <div className=\"flex items-center gap-2\">\n            <span>ADMINISTRATIVE OVERRIDE ACTIVE</span>\n          </div>\n          <Link to=\"/\" className=\"hover:text-text-primary transition-colors\">Return to standard view</Link>\n        </div>\n      )}\n      <div className=\"flex justify-between items-baseline w-full\">\n        <Link to={isAdmin ? \"/admin/events\" : \"/\"} className=\"text-6xl md:text-[140px] font-black tracking-tighter leading-[0.75] uppercase flex items-baseline gap-2 md:gap-4\">\n          SPECTRUM<span className=\"text-border-strong text-4xl md:text-[80px]\">26</span>\n          {isAdmin && <span className=\"bg-red-500 text-black px-2 py-1 text-micro rounded-sm align-middle ml-2\">ADMIN</span>}\n        </Link>\n        <div className=\"text-right flex flex-col gap-1 hidden md:flex\">\n          <div className=\"flex items-center justify-end gap-2 text-green-500\">\n            <span className=\"w-2 h-2 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.6)]\"></span>\n            <span className=\"font-mono text-xs font-bold tracking-widest uppercase\">Execution Active</span>\n          </div>\n          <div className=\"font-mono text-[10px] text-text-muted\">CRC: 0xFFA24B00 // 1024x768_VIEWPORT</div>\n        </div>\n      </div>\n      \n      {/* Mobile Navigation */}\n      <div className=\"flex md:hidden gap-4 mt-4 text-micro uppercase tracking-widest border-t border-border-default pt-4 overflow-x-auto\">\n        {!isAdmin ? (\n          <>\n            <Link to=\"/\" className={`${location.pathname === \'/\' ? \'text-text-primary\' : \'text-text-muted\'}`}>Events</Link>\n            <Link to=\"/schedule\" className={`${location.pathname === \'/schedule\' ? \'text-text-primary\' : \'text-text-muted\'}`}>Schedule</Link>\n            <Link to=\"/registrations\" className={`${location.pathname === \'/registrations\' ? \'text-text-primary\' : \'text-text-muted\'}`}>Passes</Link>\n            <Link to=\"/admin/events\" className=\"text-red-500 ml-auto\">Admin</Link>\n          </>\n        ) : (\n          <>\n            <Link to=\"/admin/events\" className={`${location.pathname === \'/admin/events\' ? \'text-text-primary\' : \'text-text-muted\'}`}>Catalog</Link>\n            <Link to=\"/admin/users\" className={`${location.pathname === \'/admin/users\' ? \'text-text-primary\' : \'text-text-muted\'}`}>Access</Link>\n            <Link to=\"/admin/audit-log\" className={`${location.pathname === \'/admin/audit-log\' ? \'text-text-primary\' : \'text-text-muted\'}`}>Audit</Link>\n          </>\n        )}\n      </div>\n    </header>\n  );\n}"
    }
